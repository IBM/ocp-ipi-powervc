set -uo pipefail
export BASEDOMAIN="example.com"
export BASTION_IMAGE_NAME="CentOS-Stream-GenericCloud-10-YYYYMMDD.N.ppc64le"
export BASTION_RSA="/home/cloud-user/.ssh/id_powervc"
export BASTION_METADATA="/home/cloud-user/"
export CLOUD="my-cloud"
export CLUSTER_DIR="test-ci"
export CLUSTER_NAME="my-ci-cluster"
export CONTROLLER_IP="192.0.2.10"
export DHCP_SUBNET="192.0.2.0"
export DHCP_NETMASK="255.255.255.0"
export DHCP_ROUTER="192.0.2.1"
export DHCP_DNS_SERVERS="192.0.2.53, 198.51.100.53, 203.0.113.53"
# DHCP server software in use: "dhcpd" or "kea"
export DHCP_SERVER="kea"
export DHCP_SERVER_ID="192.0.2.11"
export DHCP_STATS_USER="<dhcp-stats-user>"
export DHCP_STATS_PASSWORD="<dhcp-stats-password>"
export FLAVOR_NAME="my-flavor"
export INSTALLER_SSHKEY="/home/cloud-user/.ssh/id_installer_rsa.pub"
export MACHINE_TYPE="<machine-type>"
export NETWORK_NAME="my-network"
unset PROJECT
export PROJECT_UPLOAD="my-project"
export PULLSECRET_FILE="/home/cloud-user/.pullSecretCompact"
export SSHKEY_NAME="bastion-key"
export SVC_HOST="192.0.2.20"
export SVC_USER="<svc-user>"
export SVC_PASSWORD="<svc-password>"
export TEMPLATE="00000000-0000-0000-0000-000000000000"
export POWERVC_USER="<powervc-user>"
export POWERVC_PASSWORD="<powervc-password>"
export POWERVC_TENANT="my-project"
